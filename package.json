{
  "name": "meridian",
  "version": "0.1.0",
  "description": "Hosted interactive globe experience",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPatterns=unit/",
    "test:integration": "jest --testPathPatterns=integration/",
    "test:e2e": "cypress run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "audit:performance": "lighthouse --output=json --output-path=./lighthouse-report.json http://localhost:8080",
    "audit:accessibility": "lighthouse --only-categories=accessibility --output=json --output-path=./a11y-report.json http://localhost:8080",
    "audit:security": "npm audit",
    "audit:content": "node scripts/content-audit.js",
    "audit:compatibility": "node scripts/compatibility-audit.js",
    "prepare": "husky install"
  },
  "keywords": [
    "globe",
    "3d",
    "visualization"
  ],
  "author": "Ascend Maui",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "^13.5.0"
  },
  "overrides": {
    "argparse": "^2.0.0",
    "js-yaml": "^4.0.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
